# CODE X STOCKS — environment variable NAMES (never put real values in this file or in Git).
#
# Website/API (apps/web): put real values in
#   - local development:   apps/web/.env.local          (ignored by Git)
#   - production:          Vercel → Project → Settings → Environment Variables (Production)
# None of these are ever bundled into the desktop app or the browser.

# --- Neon PostgreSQL (SERVER ONLY) -----------------------------------------
# Neon console → your project → Connection Details → "Pooled connection" string, with sslmode=require.
DATABASE_URL=

# --- First-run owner creation (SERVER ONLY) --------------------------------
# A long random one-time code (32+ chars). Needed only to create the owner account the first time.
# Remove/rotate it after setup; without it no one can create an owner on a fresh deployment.
SETUP_TOKEN=

# --- ImageKit ---------------------------------------------------------------
# ImageKit dashboard → Developer options → API keys.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=            # SERVER ONLY. Never expose.
IMAGEKIT_URL_ENDPOINT=           # e.g. https://ik.imagekit.io/your_id
IMAGEKIT_FOLDER=/codex-stocks/accounts

# --- Domains / sessions -------------------------------------------------------
PUBLIC_SITE_URL=https://codexstocks.org
ADMIN_HOSTS=admin.codexstocks.org          # comma-separated hostnames that serve the admin app
ADMIN_ORIGINS=https://admin.codexstocks.org # origins allowed to make cookie-authenticated writes (CSRF check)
COOKIE_SECURE=true                          # set false ONLY for http://localhost development
# EXTRA_CORS_ORIGINS=                       # optional; Tauri WebView origins are allowed by default

# --- Local preview only -------------------------------------------------------
# DEMO_MODE=1   # with NO DATABASE_URL: in-memory Postgres + clearly labelled DEMO data. Ignored in Vercel production.

# --- Desktop build (PUBLIC, compiled into the app) --------------------------
# apps/desktop/.env : the only value the desktop app needs. Not a secret.
# VITE_API_BASE_URL=https://admin.codexstocks.org
