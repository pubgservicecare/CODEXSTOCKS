{
  "name": "codex-stocks",
  "private": true,
  "version": "1.0.0",
  "description": "CODE X STOCKS — offline-first PUBG account inventory (Windows desktop + website)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css}\"",
    "desktop:dev": "npm run tauri:dev -w @codex/desktop",
    "desktop:build": "npm run tauri:build -w @codex/desktop",
    "web:dev": "npm run dev -w @codex/web",
    "web:build": "npm run build -w @codex/web",
    "db:migrate": "npm run db:migrate -w @codex/server",
    "db:status": "npm run db:status -w @codex/server"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
